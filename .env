# Committed with safe, obviously-fake defaults so `docker compose up`
# (dev) works out of the box with zero setup.
#
# DEPLOYING TO PRODUCTION: override every one of these with real secrets,
# via real environment variables exported before `docker compose -f
# compose.yaml up` (or a secrets-injecting CI/CD step) -- real environment
# variables always take precedence over this file. The backend also
# refuses to boot in prod (APP_ENV=prod) if it detects these placeholder
# values are still in effect (see docker/backend/entrypoint.sh).

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=dev-insecure-postgres-password-do-not-use-in-prod
POSTGRES_DB=app

# --- Symfony ---
# Generate a real one with: php -r 'echo bin2hex(random_bytes(16));'
# In prod, entrypoint.sh refuses to boot if this is empty, still the
# placeholder below, or shorter than 32 characters.
APP_SECRET=dev-insecure-app-secret-do-not-use-in-prod

# --- JWT (lexik/jwt-authentication-bundle) ---
# The keypair itself is generated on first boot into the backend_jwt volume;
# this passphrase only protects that private key. Generate a real one the
# same way as APP_SECRET above. In prod, entrypoint.sh refuses to boot if
# this is empty, still the placeholder below, or shorter than 32 characters.
JWT_PASSPHRASE=dev-insecure-jwt-passphrase-do-not-use-in-prod

# --- Admin account ---
# There is no self-registration (see README): this is the only account,
# created/updated by `php bin/console app:bootstrap-admin` (run once after
# migrations, and again any time you change ADMIN_PASSWORD here to rotate
# it). In prod, entrypoint.sh refuses to boot if ADMIN_EMAIL is empty, or if
# ADMIN_PASSWORD is empty, still the placeholder below, or shorter than 8
# characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=dev-insecure-admin-password-do-not-use-in-prod

# --- CORS ---
# Regex matched against the Origin header of cross-origin requests. If the
# frontend is served through the same host nginx as the API (recommended,
# see deploy/nginx/app.prod.conf.example), requests are same-origin and this
# is never even consulted -- but nelmio/cors-bundle still requires a value.
CORS_ALLOW_ORIGIN=^http://localhost:5173$

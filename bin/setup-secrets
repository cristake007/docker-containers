#!/bin/sh
set -eu

secret_directory="${1:-secrets}"
umask 077
mkdir -p "$secret_directory"

random_hex() {
    byte_count="$1"
    od -An -N "$byte_count" -tx1 /dev/urandom | tr -d ' \n'
}

create_secret() {
    path="$1"
    byte_count="$2"

    if [ -s "$path" ]; then
        printf 'Preserving existing secret: %s\n' "$path"
        chmod 0600 "$path"
        return
    fi

    temporary_path="${path}.tmp"
    random_hex "$byte_count" > "$temporary_path"
    chmod 0600 "$temporary_path"
    mv "$temporary_path" "$path"
    printf 'Created secret: %s\n' "$path"
}

create_secret "$secret_directory/app_secret" 32
create_secret "$secret_directory/database_password" 24

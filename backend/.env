# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# These placeholders are never actually connected to: Docker Compose always
# injects the real values (from POSTGRES_* in the root .env) as container
# environment variables, which take precedence over this file. See
# config/packages/doctrine.yaml for why these are discrete parameters
# rather than a single DATABASE_URL.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# DO NOT put a real passphrase here: Compose supplies it as a real env var
# (see root .env). The private key itself is generated into the gitignored
# config/jwt/ volume by docker/backend/entrypoint.sh.
JWT_PASSPHRASE=
# Set to "0" only for local dev over plain HTTP; must stay "1" in prod.
JWT_COOKIE_SECURE=1
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Origin of the React frontend allowed to call this API with credentials.
CORS_ALLOW_ORIGIN=
###< nelmio/cors-bundle ###

###> app admin account ###
# There is no self-registration (see README): Compose supplies the real
# values as container environment variables (see root .env), which take
# precedence over this file. See App\Command\BootstrapAdminCommand.
ADMIN_EMAIL=
ADMIN_PASSWORD=
###< app admin account ###

# Example host-nginx server block for local development.
#
# This repo intentionally runs no nginx/Apache inside any container --
# PHP-FPM only speaks FastCGI, and the Vite dev server only speaks HTTP on
# its own port. nginx running on the host is what stitches the two into one
# origin, which is what makes cookie-based auth and CORS work without any
# extra configuration.
#
# Usage: copy to your nginx sites-available (e.g.
# /etc/nginx/sites-available/app.dev), symlink into sites-enabled, adjust
# server_name if needed, then reload nginx.
#
# Prerequisite: `docker compose up` running, which publishes:
#   - backend (dev, PHP-FPM)  -> 127.0.0.1:9000
#   - frontend (dev, Vite)    -> 127.0.0.1:5173
#
# GraphiQL (/api/graphql) and Swagger UI (/api, Accept: text/html) are
# enabled in dev (see backend/config/packages/api_platform.yaml) so you can
# browse the schema while building against it. Their JS/CSS come from
# `backend/public/bundles/apiplatform/`, generated by `composer install`
# (symfony/asset + `assets:install`, wired up in composer.json). Dev
# bind-mounts ./backend into the container, so that directory exists here on
# the host too -- fix the `alias` path below to match your checkout.

# $http_upgrade is only "websocket" on Vite's HMR handshake; every other
# request has it empty. Hardcoding `Connection: upgrade` for all requests
# (instead of this map) forces nginx into tunnel mode for every plain JS/CSS
# fetch too, which kills upstream keep-alive and makes the dev server feel
# far slower than it is.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name app.localhost;

    # gzip_proxied defaults to "off", which silently disables compression
    # for anything coming from proxy_pass/fastcgi_pass -- i.e. everything
    # this server block serves. Without it, `gzip on` in the main nginx.conf
    # has no effect here.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # React dev server (Vite) -- includes the HMR websocket upgrade.
    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
    }

    # Symfony API (login + GraphQL), served by PHP-FPM in
    # the backend container. The application files live inside that
    # container, not on this host, so SCRIPT_FILENAME is fixed rather than
    # derived from $document_root/try_files.
    location /api {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        # Required alongside a fixed SCRIPT_FILENAME: fastcgi_params' default
        # (the request URI itself) makes Symfony compute the wrong base
        # URL/path info for any route that depends on it -- e.g. the API
        # Platform entrypoint at exactly /api -- producing a redirect loop
        # between /api and /api/. This is Symfony's own documented fix.
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTPS $https if_not_empty;
    }

    # Static assets for the browsable API UIs above. Only needed in dev --
    # the prod example deliberately has no equivalent, since prod disables
    # both UIs (see the `when@prod` block in api_platform.yaml).
    location ^~ /bundles/apiplatform/ {
        alias /path/to/docker-containers/backend/public/bundles/apiplatform/;
    }
}

# Example host-nginx server block for production.
#
# This repo runs no nginx/Apache inside any container in prod either: the
# backend container is PHP-FPM only, and there is no frontend container at
# all -- the React build is a set of static files this nginx serves
# directly. TLS termination and certificates are this host's responsibility
# (e.g. certbot/Let's Encrypt), not something this repo manages.
#
# Usage: copy to your nginx sites-available, fix `server_name`, `root`, and
# the TLS certificate paths for your environment, then reload nginx.
#
# Prerequisites:
#   - `docker compose -f compose.yaml up -d --build` running, which
#     publishes the backend (PHP-FPM) to 127.0.0.1:9000 (loopback only)
#   - the frontend built as static files:
#       docker build -f docker/frontend/Dockerfile --target export \
#         --output type=local,dest=./frontend/dist .

# Optional complement to the app's own login_throttling (see
# backend/config/packages/security.yaml): a per-IP request-rate cap in front
# of it. `zone=login:10m` tracks ~160k distinct IPs; `rate=1r/s` with a small
# `burst` still lets a real user retry a typo without being limited by nginx
# before the app-level limiter (which is keyed by username+IP) ever sees it.
# limit_req_zone $binary_remote_addr zone=login:10m rate=1r/s;

# Plain HTTP: redirect everything to HTTPS. Credentials must never be
# accepted on this listener -- do not add any application location here.
server {
    listen 80;
    server_name your-domain.example;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name your-domain.example;

    # ssl_certificate     /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # Only once you have a real certificate and are actually serving HTTPS:
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # gzip_proxied defaults to "off", which silently disables compression for
    # anything from fastcgi_pass (the /api location below). Static files
    # under root are compressed regardless, but this keeps both paths covered.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    root /path/to/docker-containers/frontend/dist;
    index index.html;

    # Single-page app: let React Router (if added later) handle unknown
    # paths client-side instead of 404ing.
    location / {
        try_files $uri /index.html;
    }

    # Symfony API (login + GraphQL), served by PHP-FPM in the backend
    # container. The application files live inside that container, not on
    # this host, so SCRIPT_FILENAME is fixed rather than derived from
    # $document_root/try_files.
    location /api {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        # Required alongside a fixed SCRIPT_FILENAME: fastcgi_params' default
        # (the request URI itself) makes Symfony compute the wrong base
        # URL/path info for any route that depends on it -- e.g. the API
        # Platform entrypoint at exactly /api -- producing a redirect loop
        # between /api and /api/. This is Symfony's own documented fix.
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTPS $https if_not_empty;
    }

    # Uncomment alongside the limit_req_zone above to add a per-IP request
    # cap in front of the app's own login_throttling.
    # location /api/login {
    #     limit_req zone=login burst=5 nodelay;
    #     include fastcgi_params;
    #     fastcgi_pass 127.0.0.1:9000;
    #     fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
    #     fastcgi_param SCRIPT_NAME /index.php;
    #     fastcgi_param HTTPS $https if_not_empty;
    # }
}
